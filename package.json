{
  "name": "isolde",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev:web": "bun --filter @isolde/app dev",
    "dev:tauri:desktop": "bun scripts/dev.ts desktop",
    "dev:tauri:desktop:verbose": "bun scripts/dev.ts desktop --verbose",
    "dev:tauri:android": "bun scripts/dev.ts android",
    "dev:tauri:android:verbose": "bun scripts/dev.ts android --verbose",
    "dev:all": "bun scripts/dev.ts all",
    "ui:add": "bunx --cwd core/ui shadcn-svelte add",
    "dev:all:verbose": "bun scripts/dev.ts all --verbose",
    "build:desktop": "bun scripts/build.ts desktop",
    "build:android:aab": "bun scripts/build.ts android-aab",
    "build:android:apk": "bun scripts/build.ts android-apk",
    "build:all": "bun scripts/build.ts all"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --write"
  },
  "workspaces": [
    "core/*",
    "shared/*"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte-eslint-parser": "^1.8.0",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@types/node": "^26.1.2"
  }
}
