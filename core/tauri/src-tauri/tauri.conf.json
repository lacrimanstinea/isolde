{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "isoldeD",
  "version": "0.0.1",

  "identifier": "com.lacrimanstinea.isolde.development",
  "build": {
    "removeUnusedCommands": true,
    "beforeDevCommand": "",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun --filter @isolde/app build",
    "frontendDist": "../../app/build"
  },
  "app": {
    "windows": [
      {
        "title": "isolde",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "generalAutofillEnabled": false,
        "allowLinkPreview": false,
        "browserExtensionsEnabled": false,
        "zoomHotkeysEnabled": false,
        "decorations": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: blob: data:; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src * asset: blob: data:; media-src * asset: blob: data:; connect-src * ipc: http://localhost:* ws://localhost:*;",
      "freezePrototype": true
    }
  },
  "bundle": {
    "homepage": "https://github.com/lacrimanstinea/isolde",
    "license": "GPL-3.0",
    "licenseFile": "../../../LICENSE",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.13"
    },
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "publisher": "lacrimanstinea",
    "shortDescription": "isolde tracking application.",
    "longDescription": "isolde is a tracking application for web, mobile, and desktop.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "14.0"

    },
    "windows": {

      "allowDowngrades": true,
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      }
    }
  }
}
