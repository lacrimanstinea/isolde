{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "isolde",
  "version": "0.0.1",
  "identifier": "com.lacrimanstinea.isolde",
  "build": {
    "beforeDevCommand": "bun --filter @isolde/app dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun --filter @isolde/app build",
    "frontendDist": "../../app/build"
  },
  "app": {
    "windows": [
      {
        "title": "isolde",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false,
        "allowLinkPreview": false,
        "browserExtensionsEnabled": false,
        "zoomHotkeysEnabled": false,
        "decorations": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "publisher": "lacrimanstinea",
    "shortDescription": "isolde tracking application.",
    "longDescription": "isolde is a tracking application for web, mobile, and desktop.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "14.0"
    },
    "windows": {
      "allowDowngrades": true,
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      }
    }
  }
}
