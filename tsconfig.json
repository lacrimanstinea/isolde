{
  "extends": "./core/app/.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    "baseUrl": ".",
    "paths": {
      "$lib": ["./core/app/src/lib"],
      "$lib/*": ["./core/app/src/lib/*"]
    },

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": [
    "core/app/src/**/*.d.ts",
    "core/app/src/**/*.ts",
    "core/app/src/**/*.js",
    "core/app/src/**/*.svelte",
    "core/app/.svelte-kit/ambient.d.ts",
    "core/app/.svelte-kit/types/**/$types.d.ts"
  ]
}
